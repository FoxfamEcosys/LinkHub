    "@supabase/supabase-js": "^2.57.0",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
